# Environment variables for local development

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ticketforge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend (Spring)
SPRING_PROFILES_ACTIVE=dev

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost/api
